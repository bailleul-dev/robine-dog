# Copy to .env (git-ignored). `make dev` reads it.

# UI, UI API, sign-in and the logs intake.
ROBINE_DOG_LISTEN=127.0.0.1:8080
# Trace-agent API for ddtrace libraries ("off" to disable). Keep it on a
# trusted network, like a Datadog Agent's port, or set ROBINE_DOG_TRACE_REQUIRE_KEY=1.
ROBINE_DOG_TRACE_LISTEN=127.0.0.1:8126
# DogStatsD (UDP), like a local Agent ("off" to disable).
ROBINE_DOG_DOGSTATSD_LISTEN=127.0.0.1:8125

# robine-dog's own logs: text (default) or "json", one object per line.
#ROBINE_DOG_LOG_FORMAT=json
# E-mail notifications (`@someone@example.com` in a monitor message).
#ROBINE_DOG_SMTP_URL=smtp://localhost:1025
#ROBINE_DOG_SMTP_FROM=robine-dog <robine-dog@localhost>
# Browser tests (Synthetics): the Chromium to run, and extra flags.
#ROBINE_DOG_CHROMIUM=/usr/bin/chromium
#ROBINE_DOG_CHROMIUM_ARGS=--no-sandbox
# Session Replay of robine-dog's own UI (percent of sessions; needs a client token).
#ROBINE_DOG_REPLAY_SAMPLE_RATE=0

# Telemetry store and application database (`make deps` starts both).
ROBINE_DOG_GREPTIME_URL=http://127.0.0.1:14000
ROBINE_DOG_GREPTIME_DB=robine_dog
ROBINE_DOG_POSTGRES_URL=postgres://robine_dog:robine_dog@127.0.0.1:15432/robine_dog
# Logs and spans; metrics are kept 15 months.
ROBINE_DOG_RETENTION_DAYS=15
ROBINE_DOG_METRICS_RETENTION_DAYS=455

# Public address of the UI: the OIDC callback is <base>/auth/callback.
# In development the Vite server on :5173 proxies /auth and /api.
ROBINE_DOG_BASE_URL=http://localhost:5173

# DD-API-KEY the logs intake requires (any key is accepted when unset).
ROBINE_DOG_API_KEY=replace-with-a-random-key

# Key of the Sentry DSNs (http://<token>@host/sentry/<service>/1). Public, like
# a Datadog client token; without it the API key is the DSN's key.
#ROBINE_DOG_CLIENT_TOKEN=pub0123456789abcdef

# Robine ID confidential client (PKCE S256 + nonce, client_secret_post).
# ROBINE_DOG_OIDC_SUBJECTS: comma-separated immutable `sub` values allowed in.
ROBINE_DOG_OIDC_ISSUER=https://id.bailleul.dev/default
ROBINE_DOG_OIDC_CLIENT_ID=robine-dog-dev
ROBINE_DOG_OIDC_CLIENT_SECRET=change-me
ROBINE_DOG_OIDC_SUBJECTS=replace-with-your-robine-id-subject
# At least 32 characters: signs the session cookie.
ROBINE_DOG_SESSION_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
